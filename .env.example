# Copy to .env and fill in. Never commit .env.
#
# The pipeline runs without any of these: the rules decide (ADR-001), and LLM answers
# are read from the cache given with --llm-cache. With PLATO40_LLM=on a cache miss calls
# the model: guest messages (ADR-001) and the supervisor review (ADR-003).
ANTHROPIC_API_KEY=
# off (default): cache only. on: call the model on a cache miss.
PLATO40_LLM=off
# Guest-message model (llm_guard.py).
PLATO40_LLM_MODEL=claude-haiku-5-5
# Supervisor model (supervise.py).
PLATO40_SUPERVISOR_MODEL=claude-sonnet-5-5
